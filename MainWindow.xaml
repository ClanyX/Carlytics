<Window x:Class="Carlytics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Carlytics"
        KeyDown="Window_KeyDown"
        mc:Ignorable="d" Width="320" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="Log In" Height="300" Icon="/favicon.png" Background="#FF222734">
    <Grid>
        <Label Content="Carlytics" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Verdana Pro Semibold" FontSize="36
               " Foreground="#FF9EA2AD"/>
        <Grid Margin="0 80 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Name" Grid.Row="0" Grid.Column="0" Margin="5" FontFamily="Verdana Pro Semibold" FontSize="20" RenderTransformOrigin="0.5,0.5" Foreground="#FF9EA2AD"/>
            <TextBox x:Name="name" Grid.Row="0" Grid.Column="1" Margin="5" FontFamily="Verdana Pro Semibold" FontSize="20" RenderTransformOrigin="0.5,0.5" VerticalContentAlignment="Center" Background="#FF9EA2AD" Foreground="#FF131725"/>

            <Label Content="Password" Grid.Row="1" Grid.Column="0" Margin="5" FontFamily="Verdana Pro Semibold" FontSize="20" RenderTransformOrigin="0.5,0.5" Foreground="#FF9EA2AD"/>
            <PasswordBox x:Name="pass" Grid.Row="1" Grid.Column="1" Margin="5" FontFamily="Verdana Pro Semibold" FontSize="20" RenderTransformOrigin="0.5,0.5" VerticalContentAlignment="Center" Background="#FF9EA2AD" Foreground="#FF131725" />

            <Label Content="Remember me:" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" Margin="0,5,0,0" VerticalAlignment="Center" FontFamily="Verdana Pro Semibold" FontSize="12" RenderTransformOrigin="0.5,0.5" Foreground="#FF9EA2AD"/>
            <CheckBox x:Name="saved" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Background="#FF9EA2AD" Foreground="#FF131725" />

            <Button x:Name="btnLogin" Content="Log In" Grid.Row="3" Grid.Column="0" Margin="10,5,10,15" Background="#FF32F135" BorderBrush="Black" Click="onClickLogin" />
            <Button x:Name="btnCancel" Content="Cancel" Grid.Row="3" Grid.Column="1" Margin="10,5,10,15" BorderBrush="Black" Background="#FFE25C5C" Click="onClickCancel" />
        </Grid>
    </Grid>
</Window>
